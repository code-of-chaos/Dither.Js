{
    "name": "@code-of-chaos/dither",
    "version": "0.2.0",
    "description": "Framework-agnostic animated bitmap-dithered gradient backgrounds, with a tileable Perlin/fBm noise engine for generating custom dither tiles.",
    "license": "GPL-3.0-only",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./style.css": "./dist/style.css"
    },
    "types": "./dist/index.d.ts",
    "module": "./dist/index.js",
    "scripts": {
        "dev": "vite",
        "build": "vite build && tsc -p tsconfig.build.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "react",
        "dither",
        "bitmap",
        "gradient",
        "background",
        "noise",
        "perlin",
        "bayer",
        "animation"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/code-of-chaos/Dither.Js.git"
    },
    "engines": {
        "node": ">=26"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.5",
        "happy-dom": "^21.0.4",
        "typescript": "~7.0.2",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    }
}
